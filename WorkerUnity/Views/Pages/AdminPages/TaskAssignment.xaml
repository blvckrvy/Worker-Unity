<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkerUnity.Views.Pages.AdminPages.TaskAssignment"
             Title="Worker Unity">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Order="Secondary"
            Text="Archives"
            Priority="0"
            Clicked="OnArchivesClicked"/>
    </ContentPage.ToolbarItems>
    
    <ContentPage.Content>
        <ScrollView>
            <StackLayout Padding="20" VerticalOptions="Center">
                <Label
                    Text="Task Assignment"
                    FontSize="24"
                    HorizontalOptions="Center"
                    Margin="0,0,0,40"/>
                
                <!--task name-->
                <Entry
                    x:Name="taskNameEntry"
                    Placeholder="Task Name" />

                <!--task description-->
                <Editor
                    x:Name="taskDescriptionEditor"
                    Placeholder="Enter task description/instructions"
                    AutoSize="TextChanges"
                    Margin="0,20,0,0"
                    HeightRequest="100"/>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <!--worker picker-->
                    <Picker
                        x:Name="workerPicker"
                        Title="Select Worker"
                        ItemsSource="{Binding WorkersList}"
                        ItemDisplayBinding="{Binding LastName}"
                        Margin="0,0,10,0"
                        Grid.Column="0"/>
                    
                    <!--due date picker-->
                    <DatePicker
                        x:Name="duedatePicker"                        
                        Grid.Column="1"/>
                </Grid>

                <!--assign task button-->
                <Button
                    Text="Assign"
                    Clicked="OnAssignClicked"
                    WidthRequest="150"
                    CornerRadius="20"
                    BorderWidth="1"
                    BorderColor="DarkGreen"
                    Margin="0,40,0,0"/>
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>